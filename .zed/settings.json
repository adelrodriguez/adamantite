{
  "languages": {
    "Astro": {
      "format_on_save": "on",
      "prettier": {
        "allowed": true,
        "plugins": ["prettier-plugin-astro"]
      }
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "prettier": {
        "allowed": false
      },
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "MDX": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
