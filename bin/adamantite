#!/usr/bin/env node

import module from "node:module"

// V8 keeps the compiled code of the bundle in a folder of the system's temporary directory, so a
// later start skips compiling it. Child processes, such as Oxlint, do not inherit the cache. Bun
// added the function in 1.4, and an older Bun starts without the cache.
module.enableCompileCache?.()

import("../dist/index.js")
