#!/usr/bin/env node

import module from "node:module"

// V8 keeps the compiled code in a folder of the system's temporary directory. Bun added the function
// in 1.4, and an older Bun starts without the cache. A child process does not inherit the cache.
const cache = module.enableCompileCache?.()

if (cache?.directory !== undefined) {
  process.env.NODE_COMPILE_CACHE ??= cache.directory
}

import("../dist/index.js")
