{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "entry": ["presets/lint/*.ts"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "warn",
    "nsExports": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "enumMembers": "off",
    "classMembers": "off",
    "duplicates": "warn",
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["bunup.config.ts", "oxlint.config.ts"],
}
