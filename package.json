{
  "name": "adamantite",
  "version": "0.45.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "tanstack-intent",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "main": "dist/presets/lint/core.js",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": {
      "types": "./dist/presets/analyze.d.ts",
      "default": "./dist/presets/analyze.js"
    },
    "./format": {
      "types": "./dist/presets/format.d.ts",
      "default": "./dist/presets/format.js"
    },
    "./lint": {
      "types": "./dist/presets/lint/core.d.ts",
      "default": "./dist/presets/lint/core.js"
    },
    "./lint/*": {
      "types": "./dist/presets/lint/*.d.ts",
      "default": "./dist/presets/lint/*.js"
    },
    "./rules": {
      "types": "./dist/presets/rules/index.d.ts",
      "default": "./dist/presets/rules/index.js"
    },
    "./rules/testing": {
      "types": "./dist/presets/rules/testing.d.ts",
      "default": "./dist/presets/rules/testing.js"
    },
    "./typescript": "./dist/presets/tsconfig.json"
  },
  "scripts": {
    "analyze": "knip",
    "build": "tsdown",
    "build:verify": "pnpm run build && pnpm run test:build",
    "bump:deps": "pnpm update --interactive --latest",
    "check": "oxlint",
    "dev": "tsdown --watch",
    "fix": "oxlint --fix",
    "format": "oxfmt",
    "prepare": "effect-tsgo patch --oxlint --typescript",
    "release": "changeset publish",
    "test": "vitest run",
    "test:build": "node scripts/test-build.ts",
    "test:coverage": "vitest run --coverage",
    "test:dist": "pnpm run build && pnpm run test:build && pnpm run test:smoke",
    "test:presets": "vitest run --project presets",
    "test:smoke": "node scripts/test-smoke.ts",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@oxlint/plugins": "1.88.0",
    "defu": "6.1.7",
    "effect": "4.0.5",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.10",
    "oxc-parser": "0.154.0",
    "oxc-resolver": "11.24.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.54.0",
    "@effect/vitest": "4.0.5",
    "@shadcn/lint": "0.2.1",
    "@tanstack/intent": "0.5.5",
    "@types/figlet": "1.7.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "figlet": "1.12.0",
    "knip": "6.42.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2004",
    "sherif": "1.13.0",
    "tsdown": "0.23.1",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "oxlint": ">=1.88.0",
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.14.0"
}
