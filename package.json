{
  "name": "adamantite",
  "version": "0.36.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "tanstack-intent",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "main": "dist/presets/lint/core.js",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": {
      "types": "./dist/presets/analyze.d.ts",
      "default": "./dist/presets/analyze.js"
    },
    "./format": {
      "types": "./dist/presets/format.d.ts",
      "default": "./dist/presets/format.js"
    },
    "./lint": {
      "types": "./dist/presets/lint/core.d.ts",
      "default": "./dist/presets/lint/core.js"
    },
    "./lint/*": {
      "types": "./dist/presets/lint/*.d.ts",
      "default": "./dist/presets/lint/*.js"
    },
    "./typescript": "./dist/presets/tsconfig.json"
  },
  "scripts": {
    "analyze": "knip",
    "build": "tsdown",
    "bump:deps": "pnpm update --interactive",
    "check": "oxlint",
    "dev": "tsdown --watch",
    "fix": "oxlint --fix",
    "format": "oxfmt",
    "release": "changeset publish",
    "test": "vitest run",
    "test:build": "pnpm run build && node scripts/test-build.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@effect/platform-node": "4.0.0-rc.108",
    "defu": "6.1.7",
    "effect": "4.0.0-rc.108",
    "esrap": "2.3.2",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.9",
    "oxc-parser": "^0.144.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@effect/vitest": "4.0.0-rc.108",
    "@tanstack/intent": "0.3.6",
    "@types/figlet": "1.7.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "figlet": "1.11.4",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "tsdown": "0.22.14",
    "type-fest": "5.8.0",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "typescript": ">=7"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
