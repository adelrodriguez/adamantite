{
  "name": "adamantite",
  "version": "0.26.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "tsgo",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "presets"
  ],
  "type": "module",
  "main": "presets/lint/core.json",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": "./presets/knip.json",
    "./format": "./presets/format.json",
    "./lint": "./presets/lint/core.json",
    "./lint/*": "./presets/lint/*.json",
    "./typescript": "./presets/tsconfig.json",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "analyze": "bun run src/index.ts analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "bun run src/index.ts check",
    "dev": "bunup --watch",
    "fix": "bun run src/index.ts fix",
    "format": "bun run src/index.ts format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun --watch test",
    "typecheck": "bun run src/index.ts typecheck",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0-alpha.9",
    "@effect/cli": "0.73.0",
    "@effect/platform": "0.94.1",
    "@effect/platform-node": "0.104.0",
    "defu": "6.1.4",
    "effect": "3.19.14",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/bun": "1.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260108.1",
    "bunup": "0.16.17",
    "knip": "5.80.1",
    "oxfmt": "0.23.0",
    "oxlint": "1.38.0",
    "oxlint-tsgolint": "0.10.1",
    "sherif": "1.9.0",
    "type-fest": "5.3.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.3"
}
