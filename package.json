{
  "name": "adamantite",
  "version": "0.3.4",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "typescript",
    "biome",
    "preset",
    "formatter",
    "linter"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "type": "module",
  "main": "biome.jsonc",
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "biome.jsonc",
    "presets/tsconfig.json",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "biome check --write",
    "lint": "biome lint --fix",
    "release": "changeset publish",
    "test": "bun test",
    "test:watch": "bun --watch test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "commander": "^14.0.0",
    "defu": "^6.1.4",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@changesets/cli": "2.29.5",
    "@types/bun": "1.2.19",
    "tsdown": "^0.13.3",
    "type-fest": "^4.41.0"
  },
  "peerDependencies": {
    "typescript": "5.8.3"
  },
  "packageManager": "bun@1.2.18"
}
