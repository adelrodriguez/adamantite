{
  "name": "adamantite",
  "version": "0.47.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "tanstack-intent",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": {
      "types": "./dist/presets/analyze.d.ts",
      "default": "./dist/presets/analyze.js"
    },
    "./format": {
      "types": "./dist/presets/format.d.ts",
      "default": "./dist/presets/format.js"
    },
    "./lint": {
      "types": "./dist/presets/lint/core.d.ts",
      "default": "./dist/presets/lint/core.js"
    },
    "./lint/architecture": {
      "types": "./dist/presets/lint/architecture.d.ts",
      "default": "./dist/presets/lint/architecture.js"
    },
    "./lint/effect": {
      "types": "./dist/presets/lint/effect.d.ts",
      "default": "./dist/presets/lint/effect.js"
    },
    "./lint/jest": {
      "types": "./dist/presets/lint/jest.d.ts",
      "default": "./dist/presets/lint/jest.js"
    },
    "./lint/nextjs": {
      "types": "./dist/presets/lint/nextjs.d.ts",
      "default": "./dist/presets/lint/nextjs.js"
    },
    "./lint/node": {
      "types": "./dist/presets/lint/node.d.ts",
      "default": "./dist/presets/lint/node.js"
    },
    "./lint/react": {
      "types": "./dist/presets/lint/react.d.ts",
      "default": "./dist/presets/lint/react.js"
    },
    "./lint/react-strict": {
      "types": "./dist/presets/lint/react-strict.d.ts",
      "default": "./dist/presets/lint/react-strict.js"
    },
    "./lint/strict": {
      "types": "./dist/presets/lint/strict.d.ts",
      "default": "./dist/presets/lint/strict.js"
    },
    "./lint/tailwind": {
      "types": "./dist/presets/lint/tailwind.d.ts",
      "default": "./dist/presets/lint/tailwind.js"
    },
    "./lint/tanstack": {
      "types": "./dist/presets/lint/tanstack.d.ts",
      "default": "./dist/presets/lint/tanstack.js"
    },
    "./lint/vitest": {
      "types": "./dist/presets/lint/vitest.d.ts",
      "default": "./dist/presets/lint/vitest.js"
    },
    "./lint/vue": {
      "types": "./dist/presets/lint/vue.d.ts",
      "default": "./dist/presets/lint/vue.js"
    },
    "./rules": {
      "types": "./dist/presets/rules/index.d.ts",
      "default": "./dist/presets/rules/index.js"
    },
    "./rules/plugin": {
      "types": "./dist/presets/rules/plugin.d.ts",
      "default": "./dist/presets/rules/plugin.js"
    },
    "./rules/testing": {
      "types": "./dist/presets/rules/testing.d.ts",
      "default": "./dist/presets/rules/testing.js"
    },
    "./tsconfig": "./dist/presets/tsconfig.json",
    "./typescript": "./dist/presets/typescript.json"
  },
  "scripts": {
    "analyze": "knip",
    "build": "tsdown",
    "build:verify": "pnpm run build && pnpm run test:build",
    "bump:deps": "pnpm update --interactive --latest",
    "check": "node src/oxlint.ts",
    "dev": "tsdown --watch",
    "fix": "node src/oxlint.ts --fix",
    "format": "oxfmt",
    "release": "changeset publish",
    "test": "vitest run",
    "test:build": "node scripts/test-build.ts",
    "test:coverage": "vitest run --coverage",
    "test:dist": "pnpm run build && pnpm run test:build && pnpm run test:smoke",
    "test:presets": "vitest run --project presets",
    "test:smoke": "node scripts/test-smoke.ts",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "version": "changeset version"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@oxlint/plugins": "1.93.0",
    "effect": "4.1.2",
    "nypm": "0.6.10",
    "oxc-parser": "0.154.0",
    "oxc-resolver": "11.24.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.1.2",
    "@jest/globals": "30.5.2",
    "@shadcn/lint": "0.2.1",
    "@tanstack/intent": "0.5.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@types/figlet": "1.7.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "figlet": "1.12.0",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "pinia": "4.1.0",
    "react": "19.3.1",
    "sherif": "1.13.0",
    "tsdown": "0.23.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.3",
    "vitest": "5.0.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.92.0",
    "tsrs": ">=0.25.0-ts7.1.0-beta",
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "tsrs": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.14.0"
}
