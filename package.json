{
  "name": "adamantite",
  "version": "0.13.2",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "typescript",
    "biome",
    "preset",
    "formatter",
    "linter"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "type": "module",
  "main": "src/presets/biome.jsonc",
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/presets/biome.jsonc",
    "./biome": "./src/presets/biome.jsonc",
    "./tsconfig": "./src/presets/tsconfig.json",
    "./presets/*": "./src/presets/*"
  },
  "files": [
    "bin",
    "dist",
    "src/presets"
  ],
  "scripts": {
    "build": "tsdown",
    "bump:deps": "bun update --interactive",
    "check": "bun --bun run src/index.ts check",
    "dev": "tsdown --watch",
    "fix": "bun --bun run src/index.ts fix",
    "release": "changeset publish",
    "test": "bun test",
    "test:watch": "bun --watch test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "defu": "6.1.4",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.2",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/cli": "2.29.8",
    "@types/bun": "1.3.5",
    "@types/yargs": "17.0.35",
    "sherif": "1.9.0",
    "tsdown": "0.18.1",
    "type-fest": "5.3.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.3.10",
    "typescript": ">=5.6.0"
  },
  "packageManager": "bun@1.3.3"
}
