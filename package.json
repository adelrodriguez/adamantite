{
  "name": "adamantite",
  "version": "0.16.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "biome",
    "formatter",
    "linter",
    "preset",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "presets"
  ],
  "type": "module",
  "main": "presets/biome.jsonc",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    ".": "./presets/biome.jsonc",
    "./biome": "./presets/biome.jsonc",
    "./typescript": "./presets/tsconfig.json",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "bun run src/index.ts check",
    "dev": "bunup --watch",
    "fix": "bun run src/index.ts fix",
    "format": "bun run src/index.ts format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun --watch test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0-alpha.9",
    "consola": "3.4.2",
    "defu": "6.1.4",
    "faultier": "^1.1.0",
    "jsonc-parser": "3.3.1",
    "neverthrow": "8.2.0",
    "nypm": "0.6.2",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/cli": "2.29.8",
    "@types/bun": "1.3.5",
    "@types/yargs": "17.0.35",
    "bunup": "0.16.11",
    "oxfmt": "0.20.0",
    "sherif": "1.9.0",
    "type-fest": "5.3.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.3.10",
    "typescript": ">=5.6.0"
  },
  "packageManager": "bun@1.3.3"
}
