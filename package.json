{
  "name": "adamantite",
  "version": "0.30.2",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "presets"
  ],
  "type": "module",
  "main": "dist/presets/lint/core.js",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": "./dist/presets/knip.json",
    "./format": "./dist/presets/format.json",
    "./lint": {
      "types": "./dist/presets/lint/core.d.ts",
      "default": "./dist/presets/lint/core.js"
    },
    "./lint/*": {
      "types": "./dist/presets/lint/*.d.ts",
      "default": "./dist/presets/lint/*.js"
    },
    "./typescript": "./dist/presets/tsconfig.json"
  },
  "scripts": {
    "analyze": "bun run src/index.ts analyze",
    "build": "bunup && cp presets/*.json dist/presets/",
    "bump:deps": "bun update --interactive",
    "check": "bun run src/index.ts check",
    "dev": "bunup --watch",
    "fix": "bun run src/index.ts fix",
    "format": "bun run src/index.ts format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun --watch test",
    "version": "changeset version"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@clack/prompts": "1.1.0",
    "@effect/platform-node": "4.0.0-beta.35",
    "defu": "6.1.4",
    "effect": "4.0.0-beta.33",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@types/bun": "1.3.10",
    "@types/figlet": "1.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260313.1",
    "bunup": "0.16.31",
    "figlet": "1.11.0",
    "knip": "5.86.0",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.16.0",
    "sherif": "1.10.0",
    "type-fest": "5.4.4"
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.10"
}
