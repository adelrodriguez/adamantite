{
  "name": "adamantite",
  "version": "0.7.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "typescript",
    "biome",
    "preset",
    "formatter",
    "linter"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "type": "module",
  "main": "biome.jsonc",
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "biome.jsonc",
    "presets/tsconfig.json",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "biome check --write",
    "lint": "biome lint --fix",
    "release": "changeset publish",
    "test": "bun test",
    "test:watch": "bun --watch test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "14.0.0",
    "defu": "6.1.4",
    "jsonc-parser": "3.3.1",
    "nypm": "0.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@changesets/cli": "2.29.6",
    "@types/bun": "1.2.20",
    "sherif": "1.6.1",
    "tsdown": "0.14.1",
    "type-fest": "4.41.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "typescript": ">=5.8"
  },
  "packageManager": "bun@1.2.20"
}
