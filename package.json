{
  "name": "adamantite",
  "version": "0.21.0",
  "description": "An strict and opinionated set of presets for modern TypeScript applications",
  "keywords": [
    "adamantite",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "preset",
    "tsgo",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/adamantite",
  "bugs": {
    "url": "https://github.com/adelrodriguez/adamantite/issues"
  },
  "license": "MIT",
  "author": "Adel Rodriguez <hello@adelrodriguez.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/adamantite.git"
  },
  "bin": {
    "adamantite": "bin/adamantite"
  },
  "files": [
    "bin",
    "dist",
    "presets"
  ],
  "type": "module",
  "main": "presets/oxlint/core.json",
  "imports": {
    "#*": "./src/*",
    "#presets/*": "./presets/*"
  },
  "exports": {
    "./analyze": "./presets/knip.json",
    "./format": "./presets/oxfmt.json",
    "./lint": "./presets/oxlint/core.json",
    "./lint/*": "./presets/oxlint/*.json",
    "./typescript": "./presets/tsconfig.json",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "analyze": "bun run src/index.ts analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "bun run src/index.ts check",
    "dev": "bunup --watch",
    "fix": "bun run src/index.ts fix",
    "format": "bun run src/index.ts format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun --watch test",
    "typecheck": "bun run src/index.ts typecheck",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0-alpha.9",
    "defu": "6.1.4",
    "faultier": "^1.1.0",
    "jsonc-parser": "3.3.1",
    "neverthrow": "8.2.0",
    "nypm": "0.6.2",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/bun": "1.3.5",
    "@types/yargs": "17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "bunup": "0.16.17",
    "knip": "5.79.0",
    "oxfmt": "0.21.0",
    "oxlint": "1.36.0",
    "oxlint-tsgolint": "0.10.1",
    "sherif": "1.9.0",
    "type-fest": "5.3.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.3"
}
