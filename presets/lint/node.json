{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["node"],
  "rules": {
    // ==================== CORRECTNESS ====================
    "node/no-path-concat": "error",

    // ==================== RESTRICTION ====================
    "node/no-new-require": "error",

    // ======================= STYLE =======================
    "node/no-exports-assign": "error"
  }
}
