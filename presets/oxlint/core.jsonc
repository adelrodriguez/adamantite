{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest", "promise", "security"],
  "rules": {
    // ======================= COMPLEXITY =======================
    "no-regex-spaces": "error",
    "prefer-rest-params": "error",
    "typescript/ban-types": "error",
    "no-sequences": "error",
    "no-extra-boolean-cast": "error",
    "oxc/no-excessive-cognitive-complexity": ["warn", { "maxAllowedComplexity": 40 }],
    "unicorn/no-static-only-class": "error",
    "no-useless-catch": "error",
    "typescript/no-useless-empty-export": "error",
    "no-extra-label": "error",
    "no-lone-blocks": "error",
    "no-useless-rename": "error",
    "no-unneeded-ternary": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/prefer-array-flat-map": "error",
    "dot-notation": "error",
    "typescript/prefer-optional-chain": "error",
    "prefer-regex-literals": "error",
    "prefer-arrow-callback": "error",
    "unicorn/prefer-date-now": "error",

    // ======================= CORRECTNESS =======================
    "no-constant-condition": "error",
    "no-const-assign": "error",
    "no-constructor-return": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-obj-calls": "error",
    "no-inner-declarations": "error",
    "no-new-native-nonconstructor": "error",
    "constructor-super": "error",
    "typescript/no-use-before-define": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-loss-of-precision": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-case-declarations": "error",
    "no-undef": "error",
    "no-unreachable": "error",
    "no-this-before-super": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-vars": "error",
    "typescript/no-unused-vars": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "use-isnan": "error",
    "radix": "error",
    "for-direction": "error",
    "valid-typeof": "error",
    "require-yield": "error",

    // ======================= TYPE-AWARE (requires --type-aware flag) =======================
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/require-await": "error",

    // ======================= PERFORMANCE =======================
    "no-await-in-loop": "error",
    "no-delete-var": "error",

    // ======================= SECURITY =======================
    "no-eval": "error",

    // ======================= STYLE =======================
    "vitest/no-done-callback": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": "error",
    "unicorn/no-negated-condition": "error",
    "typescript/no-non-null-assertion": "error",
    "no-param-reassign": "error",
    "no-restricted-globals": ["error", "event", "name", "length", "closed"],
    "unicorn/no-lonely-if": "error",
    "unicorn/no-new-array": "error",
    "typescript/prefer-as-const": "error",
    "unicorn/prefer-at": "error",
    "curly": "error",
    "typescript/array-type": ["error", { "default": "array" }],
    "prefer-const": "error",
    "default-param-last": "error",
    "prefer-exponentiation-operator": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "one-var": ["error", "never"],
    "symbol-description": "error",
    "prefer-template": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-string-slice": "error",
    "prefer-object-spread": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-var": "error",
    "no-with": "error",
    "typescript/adjacent-overload-signatures": "error",
    "getter-return": "error",
    "guard-for-in": "error",
    "unicorn/no-instanceof-array": "error",
    "array-callback-return": "error",

    // ======================= SUSPICIOUS =======================
    "unicorn/prefer-math-trunc": "error",
    "no-cond-assign": "error",
    "no-async-promise-executor": "error",
    "no-bitwise": "error",
    "no-ex-assign": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-labels": "error",
    "no-console": "warn",
    "no-constant-binary-expression": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "eqeqeq": "error",
    "no-duplicate-case": "error",
    "no-dupe-class-members": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "vitest/no-duplicate-hooks": "error",
    "no-empty": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-explicit-any": "error",
    "vitest/no-export": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "no-fallthrough": "error",
    "vitest/no-focused-tests": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-irregular-whitespace": "error",
    "no-label-var": "error",
    "no-misleading-character-class": "error",
    "typescript/no-misused-new": "error",
    "vitest/no-conditional-in-test": "error",
    "no-octal-escape": "error",
    "no-prototype-builtins": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "no-redeclare": "error",
    "no-self-compare": "error",
    "no-shadow-restricted-names": "error",
    "vitest/no-disabled-tests": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "error",
    "unicorn/no-thenable": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "no-unsafe-negation": "error",
    "no-useless-backreference": "error",
    "default-case-last": "error",
    "unicorn/error-message": "error",
    "no-shadow": "error"
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/.git",
    "**/build",
    "**/dist",
    "**/.next",
    "**/.vercel"
  ]
}
