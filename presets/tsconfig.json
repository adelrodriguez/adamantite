{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",

    // The preset is a type-checking base. Set "noEmit": false in your project
    // if you emit output with tsc.
    "noEmit": true,

    // TypeScript 7 turns on `strict` by default. These are the stricter options that it leaves off
    // and that no lint rule covers.
    "allowUnreachableCode": false,
    // Node.js type stripping, Bun, and custom rule files run only erasable syntax. Core lint
    // reports namespaces and parameter properties, but no lint rule bans `enum`.
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  }
}
