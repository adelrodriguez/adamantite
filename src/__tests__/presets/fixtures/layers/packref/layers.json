{
  "rules": {
    "adamantite/layers": [
      "error",
      {
        "root": "src/lib",
        "ignore": [
          "**/__tests__/**"
        ],
        "layers": {
          "core": { "imports": [] },
          "shared": { "imports": [] },
          "layout": { "imports": ["core", "shared"] },
          "manifests": { "imports": ["layout"] },
          "registries": { "imports": ["layout"] },
          "store": { "imports": ["layout"] },
          "workspace": { "imports": ["layout"] },
          "sources": { "imports": ["registries", "manifests", "store", "workspace"] },
          "references": { "imports": ["sources"] }
        }
      }
    ]
  }
}
