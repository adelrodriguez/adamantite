{
  "overrides": [
    {
      "files": [
        "apps/{app,web}/src/**"
      ],
      "rules": {
        "adamantite/layers": [
          "error",
          {
            "root": "src",
            "entries": [
              "*"
            ],
            "isolate": [
              "features",
              "pages",
              "routes"
            ],
            "layers": {
              "shared": {
                "imports": []
              },
              "features": {
                "imports": [
                  "shared"
                ]
              },
              "pages": {
                "imports": [
                  "features"
                ]
              },
              "routes": {
                "imports": [
                  "features"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "files": [
        "apps/api/src/**"
      ],
      "rules": {
        "adamantite/layers": [
          "error",
          {
            "root": "src",
            "entries": [
              "*"
            ],
            "isolate": [
              "features"
            ],
            "layers": {
              "shared": {
                "imports": []
              },
              "features": {
                "imports": [
                  "shared"
                ]
              },
              "routes": {
                "imports": [
                  "features"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
