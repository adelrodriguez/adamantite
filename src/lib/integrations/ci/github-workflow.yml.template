name: adamantite

on:
  push:
    branches:
      - main
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    name: ${{ matrix.name }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        include:
{{matrix}}

    steps:
      - name: Checkout
        uses: actions/checkout@v7

{{setup}}

      - name: Run ${{ matrix.name }}
        run: ${{ matrix.command }}
