{
  "extends": "./presets/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Oxlint reports the Effect diagnostics through the effect preset.
        "diagnostics": false,
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/ByteSize",
          "effect/cli",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/process",
          "effect/Stdio",
          "effect/Terminal",
          "effect/testing/TestConsole"
        ]
      }
    ]
  },
  "include": ["src", "presets/**/*.ts", "scripts", "*.config.ts"],
  "exclude": [".packref", "dist", "node_modules", "src/__tests__/presets/fixtures"]
}
