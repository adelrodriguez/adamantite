{
  "extends": "./presets/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/ByteSize",
          "effect/cli",
          "effect/crypto/Digest",
          "effect/encoding/Json5",
          "effect/encoding/Jsonc",
          "effect/encoding/Yaml",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/process",
          "effect/SemVer",
          "effect/SemVerRange",
          "effect/Stdio",
          "effect/Terminal",
          "effect/testing/TestConsole"
        ]
      }
    ]
  },
  "include": [
    ".adamantite/lint",
    "src",
    "presets/**/*.ts",
    "scripts",
    "*.config.ts",
    "process-run-tests.ts"
  ],
  // Adamantite publishes declaration files, so it extends the plain preset without the type resets.
  "exclude": ["presets/typescript/resets", "src/__tests__/presets/fixtures"]
}
