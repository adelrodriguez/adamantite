{
  "extends": "./presets/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // The Effect server supplies editor quick fixes; editor settings hide duplicate Oxlint reports.
        "diagnostics": true,
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/ByteSize",
          "effect/cli",
          "effect/encoding/Json5",
          "effect/encoding/Jsonc",
          "effect/encoding/Yaml",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/process",
          "effect/SemVer",
          "effect/SemVerRange",
          "effect/Stdio",
          "effect/Terminal",
          "effect/testing/TestConsole"
        ]
      }
    ]
  },
  "include": ["src", "presets/**/*.ts", "scripts", "*.config.ts"],
  // Adamantite publishes declaration files, so it extends the plain preset without the type resets.
  "exclude": [
    ".packref",
    "dist",
    "node_modules",
    "presets/typescript/resets",
    "src/__tests__/presets/fixtures"
  ]
}
