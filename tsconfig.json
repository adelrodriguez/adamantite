{
  "extends": "./presets/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "presets/**/*.ts", "scripts", "*.config.ts"],
  "exclude": [".packref", "dist", "node_modules"]
}
